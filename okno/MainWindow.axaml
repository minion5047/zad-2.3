<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="Drugie okno z agentem"
        Width="600" Height="450"
        WindowStartupLocation="CenterScreen">
    <StackPanel Spacing="12" Margin="20">
        <TextBlock Text="Warsztat" HorizontalAlignment="Center" FontSize="32" Foreground="SteelBlue" />
        <TextBlock x:Name="txtPodpis" Text="Aplikacja testowa Avalonia z agentem" HorizontalAlignment="Center" FontSize="14" Foreground="Gray" />
        <Button Content="Kliknij mnie" Click="Button_Click" HorizontalAlignment="Center" CornerRadius="8" Padding="16,8" />
        <TextBox Width="300" HorizontalAlignment="Center" Watermark="Wpisz swoje imię..." />
        <Slider x:Name="suwak" Width="300" Minimum="0" Maximum="100" Value="50" HorizontalAlignment="Center" />
        <ProgressBar Width="300" Minimum="0" Maximum="100" Value="50" Height="14" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
